{
	"name": "mcu-watchlist-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check",
		"check:watch": "astro check --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test --pass-with-no-tests"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.4",
		"@vitest/browser-playwright": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^1.0.0",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.4",
		"svelte": "^5.57.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@astrojs/svelte": "^9.0.1",
		"astro": "^7.3.2",
		"nanostores": "^1.5.3"
	},
	"volta": {
		"node": "24.21.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	}
}
