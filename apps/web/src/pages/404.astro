---
// Static 404 page. staticwebapp.config.json rewrites unknown paths here (responseOverrides).
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page not found | MCU Chronological Watchlist"
	description="This page does not exist on the MCU Chronological Watchlist."
>
	<Fragment slot="head">
		<meta name="robots" content="noindex" />
	</Fragment>

	<section class="not-found">
		<h1>Page not found</h1>
		<p class="intro">
			This page does not exist. Go back to the <a href="/">watchlist</a>.
		</p>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		padding-top: 12px;
		text-align: center;
	}

	.intro {
		max-width: 820px;
		margin: 0;
		color: var(--muted);
		font-size: 17px;
		line-height: 1.6;
	}
</style>
