---
// The prerendered "/" timeline view: the catalog hero, the progress strip, the
// filter/search toolbar, and the era-grouped timeline of every catalog item.
//
// The hero markup (eyebrow/h1/intro) is static, plain .astro markup -- no reactivity needed
// there, so it is rendered directly here rather than as a Svelte island.
//
// EssentialToggle/FilterBar/SearchInput/ProgressStrip/TimelineView are mounted as independent
// fine-grained islands, each reading/writing the shared `filtersStore`/`progressStore`
// nanostore singletons directly (lib/state/filters.ts, lib/state/progress.ts) -- an .astro
// page has no client-side script of its own to hold cross-island wiring, and separately
// mounted islands don't share a closure. All but TimelineView sit above the fold and use
// client:load; TimelineView is the heaviest island and starts below the fold, so it uses
// client:visible to defer its hydration cost until it scrolls into view.
//
// The full catalog (`items`) is static, build-time data (lib/data/items.ts), passed into the
// ProgressStrip/TimelineView islands, which each recompute their own filtered slice from it --
// this is the "zero-JS catalog" prerendering goal: every item is already in the prerendered
// HTML before any store hydration happens client-side. Only `progress` (and therefore which
// items show as watched/skipped) updates after hydration.
//
// `totalEpisodesByItemId`/`episodesByItemId` (marvel-s4b, marvel-q34) are baked from the
// `episodes` Content Layer collection, keyed back from its own `imdbId-s{season}` key to the
// catalog item id every series in the catalog actually uses, since TimelineView/ProgressStrip
// are islands and can't read the collection themselves (Astro Content Layer is only readable
// from .astro frontmatter). `runtimeByItemId` (marvel-b96) and `posterByItemId` (marvel-q34)
// are built the same way, from `episodes` plus the `titleInfo` collection.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { items } from '../lib/data/items';
import type { EpisodeSummary } from '../lib/domain/upNext';
import { getSeasonNumber } from '../lib/data/mediaMetadata/itemSeason';
import { buildRuntimeIndex } from '../lib/data/runtimeIndex';
import { buildCatalogJsonLd } from '../lib/seo/jsonLd';
import { serializeJsonLd } from '../lib/seo/jsonLdScript';
import { requireSiteUrl } from '../lib/seo/siteUrl';
import FilterBar from '../lib/components/common/FilterBar.svelte';
import SearchInput from '../lib/components/common/SearchInput.svelte';
import EssentialToggle from '../lib/components/common/EssentialToggle.svelte';
import ProgressStrip from '../lib/components/common/ProgressStrip.svelte';
import TimelineView from '../lib/components/timeline/TimelineView.svelte';

const episodeEntries = await getCollection('episodes');
const episodesByKey = new Map(episodeEntries.map((entry) => [entry.id, entry.data]));

const titleInfoEntries = await getCollection('titleInfo');
const titleInfoByKey = new Map(titleInfoEntries.map((entry) => [entry.id, entry.data]));

const totalEpisodesByItemId: Record<string, number> = {};
const episodesByItemId: Record<string, EpisodeSummary[]> = {};
const posterByItemId: Record<string, string> = {};

for (const item of items) {
	const titleInfoKey = item.type === 'series' ? `${item.imdbId}-s${getSeasonNumber(item.id)}` : item.imdbId;
	const poster = titleInfoByKey.get(titleInfoKey)?.poster;
	if (poster && poster !== 'N/A') {
		posterByItemId[item.id] = poster;
	}

	if (item.type !== 'series') {
		continue;
	}

	const episodesKey = `${item.imdbId}-s${getSeasonNumber(item.id)}`;
	const entry = episodesByKey.get(episodesKey);

	if (entry) {
		totalEpisodesByItemId[item.id] = entry.totalCount;
		episodesByItemId[item.id] = entry.episodes.map(({ id, title, episodeNumber }) => ({ id, title, episodeNumber }));
	}
}

const runtimeByItemId = buildRuntimeIndex(items, episodesByKey, titleInfoByKey);

// JSON-LD (marvel-r0u): an ItemList of the full catalog, so an agent/crawler can read the
// whole chronological order straight out of the page's structured data.
const catalogJsonLd = buildCatalogJsonLd(items, requireSiteUrl(Astro.site).toString());
---

<BaseLayout>
	<Fragment slot="head">
		<title>MCU Chronological Watchlist</title>
		<meta
			name="description"
			content="Browse the MCU in chronological order, sign in to track which movies, series, shorts and specials you've watched, and see what to watch next."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.site} />
		<meta property="og:title" content="MCU Chronological Watchlist" />
		<meta
			property="og:description"
			content="Browse the MCU in chronological order, sign in to track which movies, series, shorts and specials you've watched, and see what to watch next."
		/>
		<link rel="canonical" href={Astro.site} />
		<script type="application/ld+json" set:html={serializeJsonLd(catalogJsonLd)} is:inline></script>
	</Fragment>

	<section class="hero">
		<div class="eyebrow">MCU movies, series, shorts and specials</div>
		<h1>MCU Chronological Watchlist</h1>
		<p class="intro">
			Follow the MCU timeline order, mark what you have watched, and pick up where you left off. Sign in with email to
			save your progress to your account.
		</p>
	</section>

	<div class="content">
		<ProgressStrip
			items={items}
			episodesByItemId={episodesByItemId}
			runtimeByItemId={runtimeByItemId}
			posterByItemId={posterByItemId}
			client:load
		/>

		<section class="toolbar" aria-label="Watchlist controls">
			<div class="chips">
				<EssentialToggle client:load />
				<span class="chip-divider" aria-hidden="true"></span>
				<FilterBar client:load />
			</div>

			<SearchInput client:load />
		</section>

		<div class="timeline-column">
			<TimelineView items={items} totalEpisodesByItemId={totalEpisodesByItemId} client:visible />
		</div>
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
		padding-top: 12px;
		text-align: center;
	}

	.eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		width: fit-content;
		padding: 7px 11px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.06);
		color: var(--muted);
		font-size: 13px;
		letter-spacing: 0.02em;
	}

	.eyebrow::before {
		content: '';
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 22px var(--accent);
	}

	h1 {
		margin: 0;
		font-size: clamp(38px, 5.3vw, 136px);
		line-height: 0.94;
		letter-spacing: -0.065em;
		white-space: nowrap;
	}

	.intro {
		max-width: 820px;
		margin: 0;
		color: var(--muted);
		font-size: 17px;
		line-height: 1.6;
	}

	/* Timeline keeps its narrower reading width inside the wider strip column. */
	.timeline-column {
		width: min(1152px, 100%);
		margin-inline: auto;
	}

	.content {
		display: flex;
		flex-direction: column;
		gap: 14px;
		width: min(1400px, 100%);
		margin: 30px auto 0;
	}

	.toolbar {
		position: sticky;
		top: 12px;
		z-index: 3;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding: 12px;
		border: 1px solid var(--border);
		border-radius: 26px;
		background: rgba(12, 16, 32, 0.78);
		backdrop-filter: blur(18px);
	}

	/* Island wrappers vanish from layout so the toggle, chips and search share one flex row. */
	.toolbar :global(astro-island) {
		display: contents;
	}

	.chips {
		display: flex;
		flex: 1 1 auto;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		min-width: 0;
	}

	.chip-divider {
		flex: none;
		width: 1px;
		height: 28px;
		background: rgba(255, 255, 255, 0.14);
	}

	@media (max-width: 820px) {
		h1 {
			white-space: normal;
		}

		.toolbar {
			position: static;
		}
	}
</style>
