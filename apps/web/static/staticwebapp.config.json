{
	"platform": {
		"apiRuntime": "node:20"
	},
	"responseOverrides": {
		"404": {
			"rewrite": "/404.html",
			"statusCode": 404
		}
	},
	"globalHeaders": {
		"X-Content-Type-Options": "nosniff",
		"Referrer-Policy": "strict-origin-when-cross-origin",
		"X-Frame-Options": "DENY",
		"Content-Security-Policy": "frame-ancestors 'none'"
	}
}
